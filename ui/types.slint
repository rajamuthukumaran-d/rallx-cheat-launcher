export struct CheatEntry {
    id: int,
    label: string,
    key: string,
}

export struct TrainerItem {
    id: int,
    name: string,
    version: string,
    size: string,
    exe: string,
    // Absolute path of the game this trainer is for, or empty when unset. Full
    // path rather than a filename because the game lives wherever it was
    // installed, never in the trainer folder.
    game-exe: string,
    // Command line the generated .bat starts game-exe with, or empty.
    game-args: string,
    // Absolute path of the executable whose exit triggers trainer cleanup.
    watched-exe: string,
    shortcut: string,
    auto-trigger-cheats: bool,
    cheat-delay-ms: int,
    color: color,
    letter: string,
    has-icon: bool,
    icon: image,
    cheats: [CheatEntry],
}
