import { Theme } from "../theme.slint";
import { CheatEntry } from "../types.slint";
import { ModalBackdrop } from "../components/modal-backdrop.slint";
import { IconButton } from "../components/icon-button.slint";
import { TextField } from "../components/text-field.slint";
import { ScrollView } from "std-widgets.slint";

component FieldLabel inherits Text {
    color: Theme.text-dim;
    font-size: 13px;
    font-weight: 600;
}

component RecordButton inherits Rectangle {
    in property <string> label;
    // Gamepad-focus indicator: swaps icon/label tint instead of a border ring.
    in property <bool> highlighted: false;
    callback clicked();

    background: Theme.panel2;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 7px;
    height: lay.min-height;

    lay := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        cross-axis-alignment: center;

        Rectangle {
            width: 16px;
            height: 16px;
            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: @image-url("../../assets/images/icons/record.svg");
                width: 14px;
                height: 14px;
                colorize: root.highlighted ? Theme.text : Theme.accent;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.highlighted ? Theme.accent : Theme.text;
            font-size: 14px;
            font-weight: root.highlighted ? 700 : 400;
            overflow: elide;
        }
    }

    TouchArea { clicked => { root.clicked(); } }
}

export component AddEditTrainerModal inherits ModalBackdrop {
    in property <string> title-text: "Add trainer";
    in property <string> save-label: "Add trainer";
    in-out property <string> form-name;
    in property <string> form-exe-display: "No executable selected";
    in property <string> form-shortcut-display: "Click to record shortcut";
    in property <[CheatEntry]> cheats;
    // The trainer executable is only pickable when adding - an existing
    // trainer's exe is the file it was imported as, so editing hides the
    // field rather than offering a swap. Focus indices below stay unchanged
    // either way; AppWindow's move-form-selection skips index 1 when hidden.
    in property <bool> show-exe-field: true;
    // Gamepad focus target spanning the whole form: 0 Name, 1 Trainer
    // executable, 2 Shortcut, 3 Add cheat, one stop per cheat row, then the
    // Cancel/Save row last. -1 means nothing focused. Driven by AppWindow's
    // move-form-selection/activate-form-focused via D-Pad up/down and A.
    in property <int> focused-index: -1;
    // Left/right position within the focused row (cheat row: 0 label,
    // 1 record key, 2 remove; Cancel/Save row: 0 Cancel, 1 Save). Driven by
    // AppWindow's move-form-sub-selection via D-Pad left/right.
    in property <int> sub-index: 0;

    callback name-changed(string);
    callback browse-exe();
    callback record-shortcut();
    callback add-cheat();
    callback remove-cheat(int);
    callback cheat-label-changed(int, string);
    callback record-cheat(int);
    callback cancel();
    callback save();

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 680px;
        height: 620px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 14px;
        clip: true;

        VerticalLayout {
            Rectangle {
                height: 76px;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 14px;
                    cross-axis-alignment: center;

                    Text {
                        text: root.title-text;
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    IconButton {
                        icon: @image-url("../../assets/images/icons/close.svg");
                        icon-size: 16px;
                        button-size: 34px;
                        bordered: false;
                        icon-color: Theme.text-dim;
                        tooltip-text: "Close";
                        clicked => { root.cancel(); }
                    }
                }
            }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    alignment: start;
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 22px;
                    padding-bottom: 22px;
                    spacing: 20px;

                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 6px;
                        FieldLabel {
                            text: "Name";
                            color: root.focused-index == 0 ? Theme.accent : Theme.text-dim;
                            font-weight: root.focused-index == 0 ? 700 : 600;
                        }
                        TextField {
                            placeholder: "Trainer name";
                            text <=> root.form-name;
                            highlighted: root.focused-index == 0;
                            edited => { root.name-changed(self.text); }
                        }
                    }

                    if root.show-exe-field: VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 6px;
                        FieldLabel {
                            text: "Trainer executable";
                            color: root.focused-index == 1 ? Theme.accent : Theme.text-dim;
                            font-weight: root.focused-index == 1 ? 700 : 600;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            cross-axis-alignment: center;

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 44px;
                                background: Theme.panel2;
                                border-width: 1px;
                                border-color: Theme.border;
                                border-radius: 8px;

                                Text {
                                    x: 14px;
                                    width: parent.width - 28px;
                                    height: 100%;
                                    vertical-alignment: center;
                                    text: root.form-exe-display;
                                    color: Theme.text-dim;
                                    font-size: 15px;
                                    overflow: elide;
                                }
                            }

                            Rectangle {
                                background: Theme.panel2;
                                border-width: 1px;
                                border-color: Theme.border;
                                border-radius: 8px;
                                height: 44px;
                                width: browse-lay.min-width;

                                browse-lay := HorizontalLayout {
                                    padding-left: 18px;
                                    padding-right: 18px;
                                    alignment: center;
                                    cross-axis-alignment: center;
                                    Text {
                                        text: "Browse…";
                                        color: root.focused-index == 1 ? Theme.accent : Theme.text;
                                        font-size: 14px;
                                        font-weight: root.focused-index == 1 ? 700 : 600;
                                    }
                                }

                                TouchArea { clicked => { root.browse-exe(); } }
                            }
                        }
                    }

                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 6px;
                        FieldLabel {
                            text: "Shortcut to launch trainer";
                            color: root.focused-index == 2 ? Theme.accent : Theme.text-dim;
                            font-weight: root.focused-index == 2 ? 700 : 600;
                        }
                        RecordButton {
                            label: root.form-shortcut-display;
                            highlighted: root.focused-index == 2;
                            clicked => { root.record-shortcut(); }
                        }
                    }

                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;

                        HorizontalLayout {
                            cross-axis-alignment: center;

                            FieldLabel {
                                horizontal-stretch: 1;
                                text: "Cheats to enable";
                                color: root.focused-index == 3 ? Theme.accent : Theme.text-dim;
                                font-weight: root.focused-index == 3 ? 700 : 600;
                            }

                            Rectangle {
                                width: add-cheat-lay.min-width;
                                height: add-cheat-lay.min-height;

                                add-cheat-lay := HorizontalLayout {
                                    spacing: 5px;
                                    cross-axis-alignment: center;

                                    Image {
                                        source: @image-url("../../assets/images/icons/add.svg");
                                        width: 14px;
                                        height: 14px;
                                        colorize: root.focused-index == 3 ? Theme.accent.brighter(60%) : Theme.accent;
                                    }
                                    Text {
                                        text: "Add cheat";
                                        color: root.focused-index == 3 ? Theme.accent.brighter(60%) : Theme.accent;
                                        font-size: 13px;
                                        font-weight: root.focused-index == 3 ? 800 : 600;
                                    }
                                }

                                TouchArea { clicked => { root.add-cheat(); } }
                            }
                        }

                        VerticalLayout {
                            spacing: 8px;

                            for c[i] in root.cheats: HorizontalLayout {
                                spacing: 8px;
                                cross-axis-alignment: center;

                                TextField {
                                    horizontal-stretch: 1;
                                    height: 38px;
                                    field-font-size: 14px;
                                    placeholder: "Cheat name (e.g. Infinite Health)";
                                    text: c.label;
                                    highlighted: root.focused-index == i + 4 && root.sub-index == 0;
                                    edited => { root.cheat-label-changed(c.id, self.text); }
                                }

                                RecordButton {
                                    width: 170px;
                                    label: c.key;
                                    highlighted: root.focused-index == i + 4 && root.sub-index == 1;
                                    clicked => { root.record-cheat(c.id); }
                                }

                                IconButton {
                                    icon: @image-url("../../assets/images/icons/close.svg");
                                    icon-size: (root.focused-index == i + 4 && root.sub-index == 2) ? 18px : 14px;
                                    button-size: 36px;
                                    icon-color: Theme.danger;
                                    tooltip-text: "Remove cheat";
                                    clicked => { root.remove-cheat(c.id); }
                                }
                            }

                            if root.cheats.length == 0: Text {
                                text: "No cheats added yet — click \"Add cheat\" above.";
                                color: Theme.text-dim;
                                font-size: 13px;
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 70px;

                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 10px;
                    cross-axis-alignment: center;

                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.panel2;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 8px;
                        height: cancel-lay.min-height;

                        cancel-lay := HorizontalLayout {
                            padding-top: 12px;
                            padding-bottom: 12px;
                            alignment: center;
                            Text {
                                text: "Cancel";
                                color: (root.focused-index == 4 + root.cheats.length && root.sub-index == 0) ? Theme.accent : Theme.text;
                                font-size: 15px;
                                font-weight: (root.focused-index == 4 + root.cheats.length && root.sub-index == 0) ? 800 : 600;
                            }
                        }

                        TouchArea { clicked => { root.cancel(); } }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.accent;
                        border-radius: 8px;
                        height: save-lay.min-height;

                        save-lay := HorizontalLayout {
                            padding-top: 12px;
                            padding-bottom: 12px;
                            alignment: center;
                            Text {
                                text: root.save-label;
                                color: Theme.on-accent;
                                font-size: 15px;
                                font-weight: (root.focused-index == 4 + root.cheats.length && root.sub-index == 1) ? 900 : 700;
                            }
                        }

                        TouchArea { clicked => { root.save(); } }
                    }
                }
            }
        }
    }
}
