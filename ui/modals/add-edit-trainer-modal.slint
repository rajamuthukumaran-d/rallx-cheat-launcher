import { Theme } from "../theme.slint";
import { CheatEntry } from "../types.slint";
import { ModalBackdrop } from "../components/modal-backdrop.slint";
import { IconButton } from "../components/icon-button.slint";
import { TextField } from "../components/text-field.slint";
import { ScrollView } from "std-widgets.slint";

component FieldLabel inherits Text {
    color: Theme.text-dim;
    font-size: 13px;
    font-weight: 600;
}

component RecordButton inherits Rectangle {
    in property <string> label;
    // Gamepad-focus indicator: swaps icon/label tint instead of a border ring.
    in property <bool> highlighted: false;
    callback clicked();

    background: Theme.panel2;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 7px;
    height: lay.min-height;

    lay := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        cross-axis-alignment: center;

        Rectangle {
            width: 16px;
            height: 16px;
            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: @image-url("../../assets/images/icons/record.svg");
                width: 14px;
                height: 14px;
                colorize: root.highlighted ? Theme.text : Theme.accent;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.highlighted ? Theme.accent : Theme.text;
            font-size: 14px;
            font-weight: root.highlighted ? 700 : 400;
            overflow: elide;
        }
    }

    TouchArea { clicked => { root.clicked(); } }
}

// Accent-tinted action button used for the Game section's "Generate .bat".
component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> highlighted: false;
    in property <bool> enabled: true;
    callback clicked();

    background: Theme.panel2;
    border-width: 1px;
    border-color: root.highlighted ? Theme.accent : Theme.border;
    border-radius: 8px;
    height: 40px;
    width: action-lay.min-width;
    opacity: root.enabled ? 1.0 : 0.45;

    action-lay := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        alignment: center;
        cross-axis-alignment: center;

        Image {
            source: @image-url("../../assets/images/icons/copy.svg");
            width: 14px;
            height: 14px;
            colorize: Theme.accent;
        }
        Text {
            text: root.label;
            color: Theme.accent;
            font-size: 14px;
            font-weight: root.highlighted ? 800 : 600;
        }
    }

    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// One "<something> executable" row: a read-only path display plus a Browse…
// button. Also a drop target - it publishes its own rectangle in window
// coordinates so AppWindow can hit-test a dropped file against it, since Slint
// has no file-drop event of its own to attach here.
component ExeField inherits Rectangle {
    in property <string> label-text;
    in property <string> value-text;
    in property <bool> highlighted;
    // Collapsed rather than removed when hidden, so the ids below stay
    // reachable for the drop-zone bindings; a zero-height row also makes the
    // hit test below fail on its own, with no separate visibility check.
    in property <bool> shown: true;
    callback browse();

    out property <length> zone-left: self.absolute-position.x;
    out property <length> zone-right: self.absolute-position.x + self.width;
    out property <length> zone-top: self.absolute-position.y;
    out property <length> zone-bottom: self.absolute-position.y + self.height;

    visible: root.shown;
    height: root.shown ? lay.min-height : 0px;

    lay := VerticalLayout {
        spacing: 6px;
        padding-bottom: 20px;

        FieldLabel {
            text: root.label-text;
            color: root.highlighted ? Theme.accent : Theme.text-dim;
            font-weight: root.highlighted ? 700 : 600;
        }

        HorizontalLayout {
            spacing: 10px;
            cross-axis-alignment: center;

            Rectangle {
                horizontal-stretch: 1;
                height: 44px;
                background: Theme.panel2;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 8px;

                Text {
                    x: 14px;
                    width: parent.width - 28px;
                    height: 100%;
                    vertical-alignment: center;
                    text: root.value-text;
                    color: Theme.text-dim;
                    font-size: 15px;
                    overflow: elide;
                }
            }

            Rectangle {
                background: Theme.panel2;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 8px;
                height: 44px;
                width: browse-lay.min-width;

                browse-lay := HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    alignment: center;
                    cross-axis-alignment: center;
                    Text {
                        text: "Browse…";
                        color: root.highlighted ? Theme.accent : Theme.text;
                        font-size: 14px;
                        font-weight: root.highlighted ? 700 : 600;
                    }
                }

                TouchArea { clicked => { root.browse(); } }
            }
        }
    }
}

export component AddEditTrainerModal inherits ModalBackdrop {
    in property <string> title-text: "Add trainer";
    in property <string> save-label: "Add trainer";
    in-out property <string> form-name;
    in property <string> form-exe-display: "No executable selected";
    in property <string> form-game-exe-display: "No game selected";
    in-out property <string> form-game-args;
    in property <string> form-shortcut-display: "Click to record shortcut";
    in property <[CheatEntry]> cheats;
    // Whether the Game section's body is open. Collapsed by default: a trainer
    // needs no game configured, so the section is opt-in rather than four rows
    // of empty fields between Name and the shortcut.
    in property <bool> game-expanded: false;
    // The trainer executable is only pickable when adding - an existing
    // trainer's exe is the file it was imported as, so editing hides the
    // field rather than offering a swap. Focus indices below stay unchanged
    // either way; AppWindow's move-form-selection skips index 1 when hidden.
    in property <bool> show-exe-field: true;
    // Gamepad focus target spanning the whole form: 0 Name, 1 Trainer
    // executable, 2 Game section header, 3 Game executable, 4 Game launch
    // options, 5 Generate .bat, 6 Shortcut, 7 Add cheat, one stop per cheat
    // row, then the Cancel/Save row last. -1 means nothing focused. Driven by
    // AppWindow's move-form-selection/activate-form-focused via D-Pad up/down
    // and A; 3-5 are skipped while the Game section is collapsed.
    in property <int> focused-index: -1;
    // Left/right position within the focused row (cheat row: 0 label,
    // 1 record key, 2 remove; Cancel/Save row: 0 Cancel, 1 Save). Driven by
    // AppWindow's move-form-sub-selection via D-Pad left/right.
    in property <int> sub-index: 0;

    // Drop-zone rectangles of the two executable rows, in window coordinates,
    // forwarded from the ExeFields for AppWindow's drop hit test. A row scrolled
    // out of view still reports where it would be, so the hit test also clips
    // against the scroll area below.
    out property <length> content-top: scroll.absolute-position.y;
    out property <length> content-bottom: scroll.absolute-position.y + scroll.height;
    out property <length> trainer-zone-left: trainer-field.zone-left;
    out property <length> trainer-zone-right: trainer-field.zone-right;
    out property <length> trainer-zone-top: trainer-field.zone-top;
    out property <length> trainer-zone-bottom: trainer-field.zone-bottom;
    out property <length> game-zone-left: game-field.zone-left;
    out property <length> game-zone-right: game-field.zone-right;
    out property <length> game-zone-top: game-field.zone-top;
    out property <length> game-zone-bottom: game-field.zone-bottom;

    // This modal is hidden rather than destroyed when the form closes (see
    // AppWindow), so the scroll offset would otherwise survive into the next
    // trainer the user opens.
    changed visible => {
        if self.visible {
            scroll.viewport-y = 0px;
        }
    }

    callback name-changed(string);
    callback browse-exe();
    callback browse-game-exe();
    callback game-args-changed(string);
    callback toggle-game-section();
    callback generate-bat();
    callback record-shortcut();
    callback add-cheat();
    callback remove-cheat(int);
    callback cheat-label-changed(int, string);
    callback record-cheat(int);
    callback cancel();
    callback save();

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 680px;
        height: 620px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 14px;
        clip: true;

        VerticalLayout {
            Rectangle {
                height: 76px;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 14px;
                    cross-axis-alignment: center;

                    Text {
                        text: root.title-text;
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    IconButton {
                        icon: @image-url("../../assets/images/icons/close.svg");
                        icon-size: 16px;
                        button-size: 34px;
                        bordered: false;
                        icon-color: Theme.text-dim;
                        tooltip-text: "Close";
                        clicked => { root.cancel(); }
                    }
                }
            }

            scroll := ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    alignment: start;
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 22px;
                    padding-bottom: 22px;
                    // Rows carry their own bottom padding instead of the layout
                    // spacing them, so a collapsed ExeField leaves no gap
                    // behind in edit mode.
                    spacing: 0px;

                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 6px;
                        padding-bottom: 20px;
                        FieldLabel {
                            text: "Name";
                            color: root.focused-index == 0 ? Theme.accent : Theme.text-dim;
                            font-weight: root.focused-index == 0 ? 700 : 600;
                        }
                        TextField {
                            placeholder: "Trainer name";
                            text <=> root.form-name;
                            highlighted: root.focused-index == 0;
                            edited => { root.name-changed(self.text); }
                        }
                    }

                    trainer-field := ExeField {
                        vertical-stretch: 0;
                        label-text: "Trainer executable";
                        value-text: root.form-exe-display;
                        highlighted: root.focused-index == 1;
                        shown: root.show-exe-field;
                        browse => { root.browse-exe(); }
                    }

                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 0px;
                        padding-bottom: 20px;

                        Rectangle {
                            height: game-header-lay.min-height;

                            game-header-lay := HorizontalLayout {
                                padding-bottom: 12px;
                                spacing: 8px;
                                cross-axis-alignment: center;

                                Image {
                                    source: @image-url("../../assets/images/icons/back.svg");
                                    width: 13px;
                                    height: 13px;
                                    // back.svg is a left-pointing chevron.
                                    transform-rotation: root.game-expanded ? -90deg : 180deg;
                                    colorize: root.focused-index == 2 ? Theme.accent : Theme.text-dim;
                                }

                                FieldLabel {
                                    horizontal-stretch: 1;
                                    text: "Game";
                                    color: root.focused-index == 2 ? Theme.accent : Theme.text-dim;
                                    font-weight: root.focused-index == 2 ? 700 : 600;
                                }

                                Text {
                                    text: root.game-expanded ? "Hide" : "Show";
                                    color: Theme.accent;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                            }

                            TouchArea { clicked => { root.toggle-game-section(); } }
                        }

                        game-field := ExeField {
                            vertical-stretch: 0;
                            label-text: "Game executable";
                            value-text: root.form-game-exe-display;
                            highlighted: root.focused-index == 3;
                            shown: root.game-expanded;
                            browse => { root.browse-game-exe(); }
                        }

                        if root.game-expanded: VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 6px;
                            padding-bottom: 16px;

                            FieldLabel {
                                text: "Game launch options";
                                color: root.focused-index == 4 ? Theme.accent : Theme.text-dim;
                                font-weight: root.focused-index == 4 ? 700 : 600;
                            }
                            TextField {
                                placeholder: "e.g. -dx11 -windowed";
                                field-font-size: 14px;
                                text <=> root.form-game-args;
                                highlighted: root.focused-index == 4;
                                edited => { root.game-args-changed(self.text); }
                            }
                            Text {
                                text: "Picking a Windows shortcut (.lnk) fills both fields from the shortcut's target and arguments.";
                                color: Theme.text-dim;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }

                        if root.game-expanded: VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 6px;
                            padding-bottom: 4px;

                            HorizontalLayout {
                                alignment: start;
                                ActionButton {
                                    label: "Generate .bat";
                                    highlighted: root.focused-index == 5;
                                    clicked => { root.generate-bat(); }
                                }
                            }
                            Text {
                                text: "Writes a .bat next to the game, named after it, that starts the game with the options above and then this trainer in background mode.";
                                color: Theme.text-dim;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 6px;
                        padding-bottom: 20px;
                        FieldLabel {
                            text: "Shortcut to launch trainer";
                            color: root.focused-index == 6 ? Theme.accent : Theme.text-dim;
                            font-weight: root.focused-index == 6 ? 700 : 600;
                        }
                        RecordButton {
                            label: root.form-shortcut-display;
                            highlighted: root.focused-index == 6;
                            clicked => { root.record-shortcut(); }
                        }
                    }

                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;

                        HorizontalLayout {
                            cross-axis-alignment: center;

                            FieldLabel {
                                horizontal-stretch: 1;
                                text: "Cheats to enable";
                                color: root.focused-index == 7 ? Theme.accent : Theme.text-dim;
                                font-weight: root.focused-index == 7 ? 700 : 600;
                            }

                            Rectangle {
                                width: add-cheat-lay.min-width;
                                height: add-cheat-lay.min-height;

                                add-cheat-lay := HorizontalLayout {
                                    spacing: 5px;
                                    cross-axis-alignment: center;

                                    Image {
                                        source: @image-url("../../assets/images/icons/add.svg");
                                        width: 14px;
                                        height: 14px;
                                        colorize: root.focused-index == 7 ? Theme.accent.brighter(60%) : Theme.accent;
                                    }
                                    Text {
                                        text: "Add cheat";
                                        color: root.focused-index == 7 ? Theme.accent.brighter(60%) : Theme.accent;
                                        font-size: 13px;
                                        font-weight: root.focused-index == 7 ? 800 : 600;
                                    }
                                }

                                TouchArea { clicked => { root.add-cheat(); } }
                            }
                        }

                        // Windows UIPI silently discards injected key presses
                        // aimed at a higher-integrity window, and most trainers
                        // require administrator rights - so without this note
                        // the cheats just appear to do nothing.
                        Text {
                            text: "Most trainers require administrator rights. Windows blocks key presses sent to an elevated program, so turn on Settings → Run as administrator or these cheats won't reach the trainer.";
                            color: Theme.text-dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        VerticalLayout {
                            spacing: 8px;

                            for c[i] in root.cheats: HorizontalLayout {
                                spacing: 8px;
                                cross-axis-alignment: center;

                                TextField {
                                    horizontal-stretch: 1;
                                    height: 38px;
                                    field-font-size: 14px;
                                    placeholder: "Cheat name (e.g. Infinite Health)";
                                    text: c.label;
                                    highlighted: root.focused-index == i + 8 && root.sub-index == 0;
                                    edited => { root.cheat-label-changed(c.id, self.text); }
                                }

                                RecordButton {
                                    width: 170px;
                                    label: c.key;
                                    highlighted: root.focused-index == i + 8 && root.sub-index == 1;
                                    clicked => { root.record-cheat(c.id); }
                                }

                                IconButton {
                                    icon: @image-url("../../assets/images/icons/close.svg");
                                    icon-size: (root.focused-index == i + 8 && root.sub-index == 2) ? 18px : 14px;
                                    button-size: 36px;
                                    icon-color: Theme.danger;
                                    tooltip-text: "Remove cheat";
                                    clicked => { root.remove-cheat(c.id); }
                                }
                            }

                            if root.cheats.length == 0: Text {
                                text: "No cheats added yet — click \"Add cheat\" above.";
                                color: Theme.text-dim;
                                font-size: 13px;
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 70px;

                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 10px;
                    cross-axis-alignment: center;

                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.panel2;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 8px;
                        height: cancel-lay.min-height;

                        cancel-lay := HorizontalLayout {
                            padding-top: 12px;
                            padding-bottom: 12px;
                            alignment: center;
                            Text {
                                text: "Cancel";
                                color: (root.focused-index == 8 + root.cheats.length && root.sub-index == 0) ? Theme.accent : Theme.text;
                                font-size: 15px;
                                font-weight: (root.focused-index == 8 + root.cheats.length && root.sub-index == 0) ? 800 : 600;
                            }
                        }

                        TouchArea { clicked => { root.cancel(); } }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.accent;
                        border-radius: 8px;
                        height: save-lay.min-height;

                        save-lay := HorizontalLayout {
                            padding-top: 12px;
                            padding-bottom: 12px;
                            alignment: center;
                            Text {
                                text: root.save-label;
                                color: Theme.on-accent;
                                font-size: 15px;
                                font-weight: (root.focused-index == 8 + root.cheats.length && root.sub-index == 1) ? 900 : 700;
                            }
                        }

                        TouchArea { clicked => { root.save(); } }
                    }
                }
            }
        }
    }
}
