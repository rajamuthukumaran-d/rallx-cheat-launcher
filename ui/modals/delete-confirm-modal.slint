import { Theme } from "../theme.slint";
import { ModalBackdrop } from "../components/modal-backdrop.slint";

export component DeleteConfirmModal inherits ModalBackdrop {
    in property <string> trainer-name;
    callback cancel();
    callback confirm();

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 380px;
        height: box-content.min-height;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 12px;

        box-content := VerticalLayout {
            padding: 28px;
            cross-axis-alignment: center;

            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 26px;
                background: Theme.danger.transparentize(0.82);

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("../../assets/images/icons/delete.svg");
                    width: 24px;
                    height: 24px;
                    colorize: Theme.danger;
                }
            }

            Rectangle { height: 16px; }

            Text {
                text: "Delete \"\{root.trainer-name}\"?";
                font-size: 18px;
                font-weight: 700;
                color: Theme.text;
                horizontal-alignment: center;
            }

            Rectangle { height: 8px; }

            Text {
                width: 320px;
                text: "This removes the trainer entry. The .exe on disk is not deleted.";
                font-size: 14px;
                color: Theme.text-dim;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle { height: 22px; }

            HorizontalLayout {
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.panel2;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 8px;
                    height: cancel-lay.min-height;

                    cancel-lay := HorizontalLayout {
                        padding-top: 11px;
                        padding-bottom: 11px;
                        alignment: center;

                        Text { text: "Cancel"; color: Theme.text; font-size: 15px; font-weight: 600; }
                    }

                    TouchArea { clicked => { root.cancel(); } }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.danger;
                    border-radius: 8px;
                    height: delete-lay.min-height;

                    delete-lay := HorizontalLayout {
                        padding-top: 11px;
                        padding-bottom: 11px;
                        alignment: center;

                        Text { text: "Delete"; color: #1a0505; font-size: 15px; font-weight: 700; }
                    }

                    TouchArea { clicked => { root.confirm(); } }
                }
            }
        }
    }
}
