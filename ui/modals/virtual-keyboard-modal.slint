import { Theme } from "../theme.slint";
import { ModalBackdrop } from "../components/modal-backdrop.slint";
import { IconButton } from "../components/icon-button.slint";
import { KeyboardLayout } from "../keyboard-layout.slint";

component Hint inherits HorizontalLayout {
    in property <image> icon;
    in property <string> label;
    in property <brush> icon-color;

    spacing: 6px;
    alignment: center;
    cross-axis-alignment: center;

    Image {
        source: root.icon;
        width: 22px;
        height: 22px;
        colorize: root.icon-color;
    }

    Text {
        text: root.label;
        color: Theme.text-dim;
        font-size: 12px;
        vertical-alignment: center;
    }
}

component Key inherits Rectangle {
    in property <string> label;
    in property <bool> wide: false;
    in property <bool> active: false;
    in property <bool> focused: false;
    callback clicked();

    width: wide ? 92px : 40px;
    height: 40px;
    border-radius: 6px;
    background: root.focused ? Theme.accent : (root.active ? Theme.panel : Theme.panel2);
    border-width: 1px;
    border-color: root.focused ? Theme.accent : Theme.border;

    Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.focused ? Theme.on-accent : (root.active ? Theme.accent : Theme.text);
        font-size: 14px;
        font-weight: 600;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component VirtualKeyboardModal inherits ModalBackdrop {
    in property <string> preview: "";
    in property <bool> shift: false;
    in property <int> focused-row: 0;
    in property <int> focused-col: 0;

    callback close();
    callback key-tapped(int, int);

    function key-label(key: string) -> string {
        // U+232B (erase-to-the-left) isn't in this font, so BACK reuses
        // SHIFT's glyph family (U+21E6/21E7 white arrows) pointed left
        // instead, which does render.
        if (key == "BACK") { return "⇦"; }
        if (key == "SPACE") { return "Space"; }
        if (key == "DONE") { return "Done"; }
        if (key == "SHIFT") { return "⇧"; }
        return root.shift ? key.to-uppercase() : key;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: content.min-width + 48px;
        height: content.min-height + 48px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 14px;

        IconButton {
            x: parent.width - self.width - 10px;
            y: 10px;
            icon: @image-url("../../assets/images/icons/close.svg");
            icon-size: 14px;
            button-size: 30px;
            bordered: false;
            icon-color: Theme.text-dim;
            tooltip-text: "Close keyboard";
            clicked => { root.close(); }
        }

        content := VerticalLayout {
            padding: 24px;
            spacing: 14px;

            Text {
                text: root.preview.is-empty ? "Type using the D-Pad and A" : root.preview;
                color: root.preview.is-empty ? Theme.text-dim : Theme.text;
                font-size: 18px;
                font-weight: 600;
                horizontal-alignment: center;
                overflow: elide;
            }

            for row[r] in KeyboardLayout.rows: HorizontalLayout {
                spacing: 6px;
                alignment: center;

                for key[c] in row: Key {
                    label: root.key-label(key);
                    wide: key == "SPACE" || key == "SHIFT" || key == "BACK" || key == "DONE";
                    active: key == "SHIFT" && root.shift;
                    focused: r == root.focused-row && c == root.focused-col;
                    clicked => { root.key-tapped(r, c); }
                }
            }

            Rectangle { height: 4px; }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            Rectangle { height: 4px; }

            HorizontalLayout {
                spacing: 16px;
                alignment: center;

                Hint {
                    icon: @image-url("../../assets/images/gamepad/D-Pad.svg");
                    label: "Navigate";
                    icon-color: Theme.text-dim;
                }
                Hint {
                    icon: @image-url("../../assets/images/gamepad/A.svg");
                    label: "Select";
                    icon-color: #4caf50;
                }
                Hint {
                    icon: @image-url("../../assets/images/gamepad/X.svg");
                    label: "Backspace";
                    icon-color: #4a90e2;
                }
                Hint {
                    icon: @image-url("../../assets/images/gamepad/Y.svg");
                    label: "Space";
                    icon-color: #e2c94a;
                }
                Hint {
                    icon: @image-url("../../assets/images/gamepad/Left Trigger.svg");
                    label: "Shift";
                    icon-color: Theme.text-dim;
                }
                Hint {
                    icon: @image-url("../../assets/images/gamepad/Right Trigger.svg");
                    label: "Close";
                    icon-color: Theme.text-dim;
                }
            }
        }
    }
}
