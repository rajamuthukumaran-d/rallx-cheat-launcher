// Single source of truth for the on-screen keyboard's key grid, shared by
// AppWindow (gamepad navigation/activation) and VirtualKeyboardModal
// (rendering), so the two can never drift out of sync. "SHIFT", "BACK",
// "SPACE" and "DONE" are special tokens; every other entry is a literal
// lowercase character to insert (uppercased on render/insert when shift is on).
export global KeyboardLayout {
    out property <[[string]]> rows: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"],
        ["a", "s", "d", "f", "g", "h", "j", "k", "l"],
        ["SHIFT", "z", "x", "c", "v", "b", "n", "m", "BACK"],
        ["SPACE", "DONE"],
    ];
}
