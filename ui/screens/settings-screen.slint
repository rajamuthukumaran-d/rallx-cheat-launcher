import { Theme, Palette } from "../theme.slint";
import { IconButton } from "../components/icon-button.slint";
import { ToggleSwitch } from "../components/toggle-switch.slint";
import { ScrollView } from "std-widgets.slint";

component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    // Gamepad-focus indicator: tints/bolds the label instead of a border ring.
    in property <bool> focused: false;
    in property <length> min-w: 0px;
    callback clicked();

    background: selected ? Theme.accent : Theme.panel2;
    border-width: 1px;
    border-color: selected ? Theme.accent : Theme.border;
    border-radius: 7px;
    width: max(min-w, lay.min-width);
    height: lay.min-height;

    lay := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 9px;
        padding-bottom: 9px;
        alignment: center;
        cross-axis-alignment: center;

        Text {
            text: root.label;
            color: root.selected ? Theme.on-accent : (root.focused ? Theme.accent : Theme.text);
            font-size: 14px;
            font-weight: root.focused ? (root.selected ? 900 : 800) : 600;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

component SectionLabel inherits Text {
    color: Theme.text-dim;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.8px;
}

export component SettingsScreen inherits Rectangle {
    in property <string> folder-path;
    in property <string> default-shortcut-label;
    in-out property <bool> close-after-launch: true;
    in-out property <bool> confirm-exit: true;
    // Gamepad focus target; -1 means nothing focused. Rows are: 0 trainer
    // folder, 1 default shortcut, 2 close-after-launch, 3 confirm-exit,
    // 4 accent color, 5 background, 6 row style. Must stay in sync with
    // AppWindow's settings-item-count()/activate-settings-focused()/
    // move-settings-value, which drive this from D-Pad/A/B input (left/right
    // cycle rows 4-6 in place rather than moving focus further).
    in property <int> focused-index: -1;

    callback back();
    callback browse-folder();
    callback record-default-shortcut();

    background: Theme.bg;

    VerticalLayout {
        Rectangle {
            height: 76px;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: 28px;
                padding-right: 28px;
                spacing: 16px;
                alignment: start;
                cross-axis-alignment: center;

                IconButton {
                    icon: @image-url("../../assets/images/icons/back.svg");
                    icon-size: 19px;
                    button-size: 40px;
                    icon-color: Theme.text;
                    tooltip-text: "Back";
                    clicked => { root.back(); }
                }

                Text {
                    text: "SETTINGS";
                    color: Theme.text;
                    font-size: 22px;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: start;
                max-width: 820px;
                padding: 28px;

                SectionLabel {
                    text: "General";
                }

                Rectangle { height: 6px; }

                Rectangle {
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 10px;
                    height: general-rows.min-height;

                    general-rows := VerticalLayout {
                        padding: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            cross-axis-alignment: center;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                alignment: center;

                                Text {
                                    text: "Trainer folder";
                                    color: root.focused-index == 0 ? Theme.accent : Theme.text;
                                    font-size: 16px;
                                    font-weight: root.focused-index == 0 ? 800 : 600;
                                }
                                Text { text: root.folder-path; color: Theme.text-dim; font-size: 13px; }
                            }

                            Pill {
                                label: "Browse…";
                                focused: root.focused-index == 0;
                                clicked => { root.browse-folder(); }
                            }
                        }

                        Divider { }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            cross-axis-alignment: center;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                alignment: center;

                                Text {
                                    text: "Default launch shortcut";
                                    color: root.focused-index == 1 ? Theme.accent : Theme.text;
                                    font-size: 16px;
                                    font-weight: root.focused-index == 1 ? 800 : 600;
                                }
                                Text {
                                    text: "Global hotkey to launch the trainer matching the running game";
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }

                            Pill {
                                label: root.default-shortcut-label;
                                min-w: 120px;
                                focused: root.focused-index == 1;
                                clicked => { root.record-default-shortcut(); }
                            }
                        }

                        Divider { }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            cross-axis-alignment: center;

                            Text {
                                horizontal-stretch: 1;
                                text: "Close app after launching trainer";
                                color: root.focused-index == 2 ? Theme.accent : Theme.text;
                                font-size: 16px;
                                font-weight: root.focused-index == 2 ? 800 : 600;
                                vertical-alignment: center;
                            }

                            ToggleSwitch {
                                track-width: 46px;
                                track-height: 26px;
                                checked <=> root.close-after-launch;
                            }
                        }

                        Divider { }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            cross-axis-alignment: center;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                alignment: center;

                                Text {
                                    text: "Confirm before closing app";
                                    color: root.focused-index == 3 ? Theme.accent : Theme.text;
                                    font-size: 16px;
                                    font-weight: root.focused-index == 3 ? 800 : 600;
                                }
                            }

                            ToggleSwitch {
                                track-width: 46px;
                                track-height: 26px;
                                checked <=> root.confirm-exit;
                            }
                        }
                    }
                }

                Rectangle { height: 28px; }

                SectionLabel {
                    text: "Theme";
                }

                Rectangle { height: 6px; }

                Rectangle {
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 10px;
                    height: theme-rows.min-height;

                    theme-rows := VerticalLayout {
                        padding: 18px;
                        spacing: 10px;

                        // Gamepad focus lands on the whole section (a single
                        // up/down stop); left/right then cycles the value in
                        // place, so only the section label reflects focus -
                        // the checkmark/fill already shows the active value.
                        VerticalLayout {
                            spacing: 10px;

                            Text {
                                text: "Accent color";
                                color: root.focused-index == 4 ? Theme.accent : Theme.text-dim;
                                font-size: 14px;
                                font-weight: root.focused-index == 4 ? 800 : 600;
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;

                                for hex in Palette.accents: Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: 20px;
                                    background: hex;
                                    border-width: hex == Theme.accent ? 2px : 0px;
                                    border-color: Theme.text;

                                    if hex == Theme.accent: Image {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        source: @image-url("../../assets/images/icons/check.svg");
                                        width: 18px;
                                        height: 18px;
                                        colorize: Theme.on-accent;
                                    }

                                    TouchArea {
                                        clicked => { Theme.accent = hex; }
                                    }
                                }
                            }
                        }

                        Rectangle { height: 2px; }

                        VerticalLayout {
                            spacing: 10px;

                            Text {
                                text: "Background";
                                color: root.focused-index == 5 ? Theme.accent : Theme.text-dim;
                                font-size: 14px;
                                font-weight: root.focused-index == 5 ? 800 : 600;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;

                                Pill {
                                    label: "Dark";
                                    selected: Theme.dark;
                                    clicked => { Theme.dark = true; }
                                }
                                Pill {
                                    label: "Light";
                                    selected: !Theme.dark;
                                    clicked => { Theme.dark = false; }
                                }
                            }
                        }

                        Rectangle { height: 2px; }

                        VerticalLayout {
                            spacing: 10px;

                            Text {
                                text: "Row style";
                                color: root.focused-index == 6 ? Theme.accent : Theme.text-dim;
                                font-size: 14px;
                                font-weight: root.focused-index == 6 ? 800 : 600;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;

                                Pill {
                                    label: "Comfortable";
                                    selected: !Theme.compact;
                                    clicked => { Theme.compact = false; }
                                }
                                Pill {
                                    label: "Compact";
                                    selected: Theme.compact;
                                    clicked => { Theme.compact = true; }
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 120px; }
            }
        }
    }
}
