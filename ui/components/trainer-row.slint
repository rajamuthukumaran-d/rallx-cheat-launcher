import { Theme } from "../theme.slint";
import { TrainerItem } from "../types.slint";
import { IconButton } from "icon-button.slint";

export component TrainerRow inherits Rectangle {
    in property <TrainerItem> trainer;
    in property <bool> edit-mode: false;
    in property <bool> selected: false;

    callback launch();
    callback edit();
    callback delete();
    callback copy();

    // ListView only permits a single `for` as its direct child, so row-to-row
    // spacing can't come from a wrapping layout's `spacing` - instead each row
    // reserves Theme.row-gap of transparent space below its own visible card.
    height: Theme.row-icon-size + Theme.row-padding-v * 2 + Theme.row-gap;

    card := Rectangle {
        y: 0;
        width: 100%;
        height: parent.height - Theme.row-gap;
        border-radius: 10px;
        background: selected ? Theme.accent.mix(Theme.panel, 0.14) : Theme.panel;
        border-width: 1px;
        border-color: selected ? Theme.accent : Theme.border;

        animate background, border-color { duration: 100ms; }

        HorizontalLayout {
            padding-left: Theme.row-padding-h;
            padding-right: Theme.row-padding-h;
            padding-top: Theme.row-padding-v;
            padding-bottom: Theme.row-padding-v;
            spacing: Theme.row-inner-gap;
            cross-axis-alignment: center;

            Rectangle {
                width: Theme.row-icon-size;
                height: Theme.row-icon-size;
                border-radius: 9px;
                background: trainer.color;

                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: trainer.letter;
                    color: Theme.on-accent;
                    font-size: 18px;
                    font-weight: 700;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                Text {
                    text: trainer.name;
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 600;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Text { text: "v" + trainer.version; color: Theme.text-dim; font-size: 13px; }
                    Text { text: "·"; color: Theme.text-dim; font-size: 13px; }
                    Text { text: trainer.size; color: Theme.text-dim; font-size: 13px; }
                    Text { text: "·"; color: Theme.text-dim; font-size: 13px; }
                    Text { text: trainer.exe; color: Theme.text-dim; font-size: 13px; }
                }
            }

            if edit-mode: HorizontalLayout {
                spacing: 8px;
                alignment: end;
                cross-axis-alignment: center;

                IconButton {
                    icon: @image-url("../../assets/images/icons/copy.svg");
                    icon-size: 17px;
                    button-size: 38px;
                    icon-color: Theme.text-dim;
                    tooltip-text: "Copy launch script";
                    clicked => { root.copy(); }
                }
                IconButton {
                    icon: @image-url("../../assets/images/icons/edit.svg");
                    icon-size: 17px;
                    button-size: 38px;
                    icon-color: Theme.text-dim;
                    tooltip-text: "Edit";
                    clicked => { root.edit(); }
                }
                IconButton {
                    icon: @image-url("../../assets/images/icons/delete.svg");
                    icon-size: 17px;
                    button-size: 38px;
                    icon-color: Theme.danger;
                    tooltip-text: "Delete";
                    clicked => { root.delete(); }
                }
            }

            IconButton {
                icon: @image-url("../../assets/images/icons/play.svg");
                icon-size: 19px;
                button-size: Theme.row-icon-size;
                icon-color: Theme.on-accent;
                button-bg: Theme.accent;
                bordered: false;
                tooltip-text: "Launch";
                clicked => { root.launch(); }
            }
        }
    }
}
